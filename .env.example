# Copy this file to .env and fill in only what you actually need.
# With nothing set at all, the defaults below already give you a fully offline,
# zero-credential run (see OFFLINE_MODE).

# --- Master offline switch -------------------------------------------------
# When true, every MOCK_* flag below is forced on regardless of its own value,
# the UI log translator stops calling the LLM, and any code path that still tries
# a real paid API call raises immediately instead of silently spending money.
# This is the default posture for local development and CI.
OFFLINE_MODE=true

# --- Vendor credentials ------------------------------------------------------
# Only needed if you flip OFFLINE_MODE (or the matching MOCK_* flag) off for that
# vendor. Leave blank while working offline.
OPENAI_API_KEY=
RAPIDAPI_KEY=
BRAVE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=real-estate-app
# Only used by scripts/sync_knowledge_base.py (Azure Blob -> Pinecone sync), not
# by the web app itself.
AZURE_STORAGE_CONNECTION_STRING=

# GH_TOKEN is read by config/config.py but is not currently used to call any LLM
# (see the commented-out GitHub Models experiment in config/llm.py). Safe to leave
# unset; only relevant if you resurrect that path.
GH_TOKEN=

# --- Database -----------------------------------------------------------------
# Use POSTGRES_DSN, never DATABASE_URL - the latter is silently claimed by
# Chainlit's own persistence layer (chainlit/data/__init__.py) and breaks on this
# app's postgresql+asyncpg:// scheme. The default below matches docker-compose.yml.
POSTGRES_DSN=postgresql+asyncpg://realestateapp:realestateapp@localhost:5432/realestateapp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
# Escape hatch for running with no database at all. When true (the default), an
# unreachable database makes the app fail to start rather than boot and silently
# record nothing.
DB_PERSISTENCE_ENABLED=true

# --- Authentication (JWT) ------------------------------------------------------
# HS256 access + refresh tokens (see auth/tokens.py). The default secret below
# only makes sense for the offline/dev/CI posture this repo runs under - a real
# deployment must override it with a long random value.
JWT_SECRET_KEY=dev-only-insecure-secret-change-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS -----------------------------------------------------------------
# Comma-separated exact origins (scheme+host+port) allowed to make cross-origin
# browser requests against this API, e.g. https://app.example.com,http://localhost:3000.
# Empty by default: with nothing set, every cross-origin browser request is
# rejected. Never set this to "*" - the app fails to start if you do (this
# API's clients send credentials, which a wildcard origin cannot be combined
# with; see config/config.py's own comment).
CORS_ALLOWED_ORIGINS=

# --- Service-to-service API keys -------------------------------------------
# Comma-separated static keys letting a machine caller (a script, a cron job,
# a partner integration) authenticate as the seeded demo user without logging
# in for a JWT - see auth/api_keys.py. Empty by default: no key authenticates
# anything until you set one. Generate a real one with, e.g., `openssl rand
# -hex 32`; never a memorable string.
SERVICE_API_KEYS=

# --- Rate limiting (token bucket) ------------------------------------------
# One bucket per authenticated identity, guarding every /api/v1/reports route
# (see rate_limit/). A separate logical Redis DB index from the Celery broker
# (0) and result backend (1), for the same reason those two are split from
# each other below.
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
# Maximum burst one identity can spend before being throttled; refills
# continuously at RATE_LIMIT_REFILL_PER_SECOND tokens/second, capped here.
RATE_LIMIT_BUCKET_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=2.0
# TTL (seconds) on the Redis key backing one identity's bucket, so a caller
# who stops calling entirely doesn't leave a key in Redis forever.
RATE_LIMIT_KEY_TTL_SECONDS=600

# --- Task queue (Celery + Redis) ----------------------------------------------
# Broker (the task queue itself) and result backend (task state/return values)
# are logically separate stores, kept on separate Redis DB indices by default
# so queue inspection and result lookups never scan through each other's keys,
# even though both point at the same Redis server here.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# How often (seconds) app.py/cli.py re-check the job row after enqueueing a
# report generation task, and how long (seconds) they keep checking before
# giving up and telling the user it's taking longer than expected. This is
# a stand-in for real push-based progress (SSE, added in a later phase).
REPORT_POLL_INTERVAL_SECONDS=1.0
REPORT_POLL_TIMEOUT_SECONDS=300

# generate_report's retry policy: a task that raises is redelivered up to
# TASK_MAX_RETRIES times, with an exponential (base * 2**retries, capped at
# max) randomized backoff between attempts, before it's treated as poison
# and routed to the DEAD_LETTER_QUEUE_NAME queue instead of retried forever.
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_BASE_SECONDS=1
TASK_RETRY_BACKOFF_MAX_SECONDS=8
DEAD_LETTER_QUEUE_NAME=dead_letter
# Deliberate failure injection for exercising the retry/DLQ path on demand:
# 0 (default) is inert. Set to N to make generate_report's first N physical
# attempts raise a simulated failure before doing any real work.
TASK_FAILURE_INJECTION_COUNT=0

# --- Scheduled jobs (Celery Beat) ---------------------------------------------
# How often (seconds) Beat re-enqueues worker.sync_knowledge_base. Real zoning
# PDFs change on the order of days, so 6 hours is a reasonable production
# default; set this much lower (e.g. 10) for local/CI verification.
KNOWLEDGE_BASE_SYNC_SCHEDULE_SECONDS=21600
# TTL (seconds) on the Redis lock held for the duration of one sync, guarding
# against overlapping runs. Must comfortably exceed how long a real sync takes;
# also the safety net if a worker dies mid-sync while holding the lock.
KNOWLEDGE_BASE_SYNC_LOCK_TTL_SECONDS=1800
# Mirrors the per-agent MOCK_*_AGENT_OUTPUT flags: short-circuits the knowledge
# base sync to a deterministic, zero-network summary instead of touching Azure
# Blob Storage, OpenAI embeddings and Pinecone for real. OFFLINE_MODE implies
# this too.
MOCK_KNOWLEDGE_BASE_SYNC=false

# --- Per-agent mocks ---------------------------------------------------------
# Each of these independently short-circuits one graph node to a canned fixture
# response from tests/fixtures/. OFFLINE_MODE=true implies all of them; set them
# individually only if you want a partially-live run with OFFLINE_MODE=false.
MOCK_INGEST_INPUT_AGENT_OUTPUT=false
MOCK_MARKET_DATA_AGENT_OUTPUT=false
MOCK_NEIGHBORHOOD_VIBE_AGENT_OUTPUT=false
MOCK_ZONING_LAW_AGENT_OUTPUT=false
MOCK_FINANCIAL_MODELER_AGENT_OUTPUT=false

# Mocks only the RapidAPI HTTP call inside the Market Data agent (fixture-backed),
# independent of MOCK_MARKET_DATA_AGENT_OUTPUT which mocks the whole node.
MOCK_MARKET_DATA_API=false

# --- Misc ---------------------------------------------------------------------
# Verbose console/UI logging (raw request URLs, env var dump on chat start, etc).
DEBUG_MODE=false
