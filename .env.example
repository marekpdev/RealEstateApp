# Copy this file to .env and fill in only what you actually need.
# With nothing set at all, the defaults below already give you a fully offline,
# zero-credential run (see OFFLINE_MODE).

# --- Master offline switch -------------------------------------------------
# When true, every MOCK_* flag below is forced on regardless of its own value,
# the UI log translator stops calling the LLM, and any code path that still tries
# a real paid API call raises immediately instead of silently spending money.
# This is the default posture for local development and CI.
OFFLINE_MODE=true

# --- Vendor credentials ------------------------------------------------------
# Only needed if you flip OFFLINE_MODE (or the matching MOCK_* flag) off for that
# vendor. Leave blank while working offline.
OPENAI_API_KEY=
RAPIDAPI_KEY=
BRAVE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=real-estate-app
# Only used by scripts/sync_knowledge_base.py (Azure Blob -> Pinecone sync), not
# by the web app itself.
AZURE_STORAGE_CONNECTION_STRING=

# GH_TOKEN is read by config/config.py but is not currently used to call any LLM
# (see the commented-out GitHub Models experiment in config/llm.py). Safe to leave
# unset; only relevant if you resurrect that path.
GH_TOKEN=

# --- Per-agent mocks ---------------------------------------------------------
# Each of these independently short-circuits one graph node to a canned fixture
# response from tests/fixtures/. OFFLINE_MODE=true implies all of them; set them
# individually only if you want a partially-live run with OFFLINE_MODE=false.
MOCK_INGEST_INPUT_AGENT_OUTPUT=false
MOCK_MARKET_DATA_AGENT_OUTPUT=false
MOCK_NEIGHBORHOOD_VIBE_AGENT_OUTPUT=false
MOCK_ZONING_LAW_AGENT_OUTPUT=false
MOCK_FINANCIAL_MODELER_AGENT_OUTPUT=false

# Mocks only the RapidAPI HTTP call inside the Market Data agent (fixture-backed),
# independent of MOCK_MARKET_DATA_AGENT_OUTPUT which mocks the whole node.
MOCK_MARKET_DATA_API=false

# --- Misc ---------------------------------------------------------------------
# Verbose console/UI logging (raw request URLs, env var dump on chat start, etc).
DEBUG_MODE=false
